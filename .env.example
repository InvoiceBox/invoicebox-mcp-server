# Демонстрационный магазин из документации: /docs/api/auth/
INVOICEBOX_API_TOKEN=b37c4c689295904ed21eee5d9a48d42e
INVOICEBOX_MERCHANT_ID=ffffffff-ffff-ffff-ffff-ffffffffffff
INVOICEBOX_ENV=demo

# Наборы инструментов: read по умолчанию, write и refund включаются явно
INVOICEBOX_TOOLSETS=read

# Каталог состояния: без него защита от дублей живёт только в пределах запуска
INVOICEBOX_STATE_DIR=.state

# Настройки, у которых есть разумные значения по умолчанию
# INVOICEBOX_RATE_LIMIT=60/30
# INVOICEBOX_LIMITS={"refundCount":10}
# INVOICEBOX_LOG_LEVEL=info

# Внешние приёмники журнала выключены по умолчанию: сервер работает в чужом периметре
# INVOICEBOX_GRAYLOG_URL=udp://gelf.example.ru:12201
# INVOICEBOX_SENTRY_DSN=https://key@sentry.example.ru/42

# Аутентификация сессии в SaaS-режиме: токен клиента проверяется его обменом на токен
# для API (RFC 8693). Адреса ниже — значения по умолчанию, задавать их нужно только
# своей установке; обязательны лишь идентификатор и секрет клиента: без них проверка
# выключена, а транспорт остаётся закрытым сетью
# INVOICEBOX_PUBLIC_URL=https://mcp.invoicebox.ru/mcp
# INVOICEBOX_OAUTH_ISSUERS=https://api.invoicebox.ru
# INVOICEBOX_OAUTH_TOKEN_ENDPOINT=https://api.invoicebox.ru/v3/security/oauth/token
# INVOICEBOX_OAUTH_API_RESOURCE=https://api.invoicebox.ru
# INVOICEBOX_OAUTH_CLIENT_ID=invoicebox-mcp
# INVOICEBOX_OAUTH_CLIENT_SECRET=
